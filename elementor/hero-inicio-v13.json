        {
         "id": "4f776b42",
         "elType": "widget",
         "widgetType": "html",
         "isInner": false,
         "settings": {
          "html": "<div class=\"mk-hoy\" data-semana=\"11:00-17:00\" data-finde=\"09:30-18:00\">\n  <p class=\"mk-hoy-estado\"><span class=\"mk-hoy-dot\" aria-hidden=\"true\"></span><span data-txt>Hoy abrimos</span></p>\n  <p class=\"mk-hoy-horas\"><span data-abre>11:00 a. m.</span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg><span data-cierra>5:00 p. m.</span></p>\n</div>\n<style>\n.mk-hoy p { margin: 0; }\n.mk-hoy { display: grid; gap: 6px; font-family: Montserrat, sans-serif; color: #fff; }\n.mk-hoy-estado { display: flex; align-items: center; gap: 8px; font-size: 15px; color: #D9D3E0; }\n.mk-hoy-dot { width: 9px; height: 9px; background: #9FE8C8; }\n.mk-hoy[data-cerrado] .mk-hoy-dot { background: #F4A39A; }\n.mk-hoy-horas { display: flex; align-items: center; gap: 12px; font-size: 28px; font-weight: 700; white-space: nowrap; }\n.mk-hoy-horas svg { color: #FFE25C; flex: none; }\n@media (max-width: 767px) { .mk-hoy-horas { font-size: 24px; } }\n</style>\n<script>\n(function () {\n  /* Horario de hoy con la hora de Bogotá. Los festivos no se detectan: cambia data-semana y data-finde si cambia el horario. */\n  var fmt = function (hm) { var p = hm.split(':').map(Number); return ((p[0] + 11) % 12 + 1) + ':' + String(p[1]).padStart(2, '0') + (p[0] >= 12 ? ' p. m.' : ' a. m.'); };\n  var min = function (hm) { var p = hm.split(':').map(Number); return p[0] * 60 + p[1]; };\n  document.querySelectorAll('.mk-hoy').forEach(function (el) {\n    var ahora = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Bogota' }));\n    var finde = ahora.getDay() === 0 || ahora.getDay() === 6;\n    var h = (finde ? el.dataset.finde : el.dataset.semana).split('-');\n    var m = ahora.getHours() * 60 + ahora.getMinutes();\n    el.querySelector('[data-abre]').textContent = fmt(h[0]);\n    el.querySelector('[data-cierra]').textContent = fmt(h[1]);\n    var txt = el.querySelector('[data-txt]');\n    if (m < min(h[0])) txt.textContent = 'Hoy abrimos';\n    else if (m < min(h[1])) txt.textContent = 'Abierto ahora';\n    else { txt.textContent = 'Cerrado ahora · Así abrimos hoy'; el.setAttribute('data-cerrado', ''); }\n  });\n})();\n</script>\n"
         },
