---
/* Descubre: programas y proyectos, experiencias, Conoce Maloka, recursos educativos y noticias.
   Ritmo de color: violeta (encabezado) · blanco · blanco con tarjeta oscura del Cine Domo · violeta · blanco · lila. */
import Base from '../layouts/Base.astro';
import ElHeader from '../components/elementor/ElHeader.astro';
import PageHero from '../components/pagina/PageHero.astro';
import AnclasNav from '../components/pagina/AnclasNav.astro';
import DesProgramas from '../components/descubre/DesProgramas.astro';
import V7Vive from '../components/v7/V7Vive.astro';
import DesConoce from '../components/descubre/DesConoce.astro';
import DesRecursos from '../components/descubre/DesRecursos.astro';
import Noticias from '../components/sections/Noticias.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import d from '../data/descubre-pagina.json';
import { url } from '../lib/url.js';
import '../styles/elementor.css';
---
<Base title="Descubre · Programas, experiencias y recursos · Maloka" description="Programas y proyectos de Maloka, experiencias, quiénes somos, recursos educativos y noticias." variante="descubre" clase="el">
  <ElHeader transparente ctaVariante="azul" inicio={url('v7/')} />
  <main id="contenido">
    <PageHero titulo="Descubre Maloka" lead="La ciencia también transforma territorios, comunidades e ideas. Conoce lo que hacemos dentro y fuera del museo.">
      <Fragment slot="ctas">
        <Button href="#programas" variant="destacado" size="lg" icon="arrow" class="btn--movil-bloque">Programas y proyectos</Button>
        <Button href="#recursos" variant="invertido" size="lg" class="btn--movil-bloque">Recursos educativos</Button>
      </Fragment>
    </PageHero>
    <AnclasNav secciones={d.secciones} />
    <DesProgramas />
    <V7Vive />
    <DesConoce />
    <DesRecursos />
    <div class="des-no"><Noticias variante="v5" sinFecha /></div>
  </main>
  <Footer />
</Base>
<style>
  .des-no :global(.no) { margin-top: var(--mk-seccion); padding-block: var(--mk-seccion); background: var(--mk-fondo-alt); border-block: 1px solid var(--mk-borde); }
  .des-no + :global(footer) { margin-top: 0; }
  :global(#programas), :global(#vive), :global(#recursos), :global(#noticias) { scroll-margin-top: 140px; }
</style>
