<script>
  /* Pestañas de Cómo llegar: en Elementor es el widget Pestañas, que ya trae este comportamiento */
  document.querySelectorAll('[data-vi-tabs]').forEach((tl) => {
    const tabs = [...tl.querySelectorAll('[role="tab"]')];
    const activar = (t) => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; document.getElementById(x.getAttribute('aria-controls')).hidden = !on; });
      t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => activar(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') activar(tabs[(i + 1) % tabs.length]);
        if (e.key === 'ArrowLeft') activar(tabs[(i - 1 + tabs.length) % tabs.length]);
      });
    });
  });
</script>
