---
/* Página de una noticia · propuesta para la plantilla «Entrada individual» de Entradas en el Theme Builder.
   Una sola plantilla para todas las noticias:
   1. Migas · 2. Cabecera hueso: categoría, fecha y tiempo de lectura, título, extracto, compartir; imagen destacada
   cuadrada a la derecha · 3. Cuerpo en una columna de lectura (contenido de la entrada) con buena tipografía
   · 4. Compartir y «Volver a noticias» · 5. Más noticias (relacionadas).
   JSON importable: elementor/noticia-single-v13.json. Contenido real de maloka.org. */
import Base from '../../../layouts/Base.astro';
import NHeader from '../../../components/n/NHeader.astro';
import NNoticia from '../../../components/n/NNoticia.astro';
import NFooter from '../../../components/n/NFooter.astro';
import Icon from '../../../components/ui/Icon.astro';
import { noticias as n, slugNoticia, categoria, fechaLarga } from '../../../lib/noticias.js';
import { url } from '../../../lib/url.js';
import iconos from '../../../data/n/redes-iconos.json';
import '../../../styles/noche.css';

export function getStaticPaths() {
  return n.items.map((it) => ({ params: { slug: slugNoticia(it) }, props: { it } }));
}
const { it } = Astro.props;
const G = 'seleccion';
const cat = categoria(it);
const mismas = n.items.filter((x) => x !== it && x.categoria === it.categoria);
const otras = n.items.filter((x) => x !== it && x.categoria !== it.categoria);
const relacionadas = [...mismas, ...otras].slice(0, 3);
const enlace = it.url; // en WordPress, el enlace propio de la entrada
const t = encodeURIComponent(it.titulo);
const u = encodeURIComponent(enlace);
const compartir = [
  { nombre: 'WhatsApp', icono: 'whatsapp', href: `https://wa.me/?text=${t}%20${u}` },
  { nombre: 'Facebook', icono: 'facebook-f', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { nombre: 'X', icono: 'x-twitter', href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { nombre: 'LinkedIn', icono: 'linkedin-in', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
];
---
<Base variante="noticia" grupo={G} title={`${it.titulo} · Noticias · Maloka`} description={it.resumen} clase="nn">
  <NHeader variante="blanco" panel="hueso" grupo={G} inicio={url(`${G}/`)} />
  <main id="contenido">
    <article>
      <header class="nt-hero n-hueso">
        <div class="mk-w">
          <nav class="nt-migas" aria-label="Ruta"><a href={url(`${G}/`)}>Inicio</a><span aria-hidden="true">/</span><a href={url(`${G}/noticias/`)}>Noticias</a><span aria-hidden="true">/</span><span aria-current="page">{cat?.label}</span></nav>
          <div class="nt-hero-in">
            <div class="nt-hero-t">
              <p class="nt-meta">{cat && <span class={`n-tag n-tag--${cat.color}`}>{cat.label}</span>}<time datetime={it.fecha}>{fechaLarga(it.fecha)}</time><span>· {it.lectura} min de lectura</span></p>
              <h1 class="nt-h1">{it.titulo}</h1>
              <p class="nt-lead">{it.resumen}</p>
              <div class="nt-comp" aria-label="Compartir"><span>Compartir</span>{compartir.map((c) => <a href={c.href} target="_blank" rel="noopener" title={`Compartir en ${c.nombre}`} aria-label={`Compartir en ${c.nombre} (abre en una pestaña nueva)`}><svg viewBox={iconos[c.icono].viewBox} width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d={iconos[c.icono].d} /></svg></a>)}</div>
            </div>
            <figure class="nt-img"><img src={it.imagen} alt="" width="1080" height="1080" /></figure>
          </div>
        </div>
      </header>

      <div class="n-sec n-blanco">
        <div class="mk-w">
          <div class="nt-cuerpo" set:html={it.contenido} />
          <div class="nt-pie">
            <a class="n-a" href={url(`${G}/noticias/`)}><Icon name="arrowl" size="18" />Volver a noticias</a>
            <div class="nt-comp" aria-label="Compartir"><span>Compartir</span>{compartir.map((c) => <a href={c.href} target="_blank" rel="noopener" title={`Compartir en ${c.nombre}`} aria-label={`Compartir en ${c.nombre} (abre en una pestaña nueva)`}><svg viewBox={iconos[c.icono].viewBox} width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d={iconos[c.icono].d} /></svg></a>)}</div>
          </div>
        </div>
      </div>
    </article>

    <section class="n-sec n-hueso" aria-labelledby="nt-mas">
      <div class="mk-w">
        <div class="n-head"><div><p class="n-ante">Sigue leyendo</p><h2 class="n-titulo" id="nt-mas">Más noticias</h2></div><a class="n-a" href={url(`${G}/noticias/`)}>Todas las noticias<Icon name="arrow" size="20" /></a></div>
        <ul class="nt-rel">{relacionadas.map((r) => <li><NNoticia item={r} grupo={G} /></li>)}</ul>
      </div>
    </section>
  </main>
  <NFooter grupo={G} />
</Base>

<style>
  .nt-hero { padding-block: 32px 64px; }
  .nt-migas { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; font-size: 14px; font-weight: 600; color: var(--n-texto2); }
  .nt-migas a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .nt-migas [aria-current] { color: var(--n-noche); }
  .nt-hero-in { display: grid; grid-template-columns: 7fr 5fr; gap: 56px; align-items: center; }
  .nt-hero-t { display: grid; gap: 20px; align-content: start; }
  .nt-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 15px; font-weight: 600; color: var(--n-texto2); }
  .nt-h1 { margin: 0; font-size: 48px; line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; }
  .nt-lead { font-size: 20px; line-height: 1.55; color: var(--n-texto2); }
  .nt-img { margin: 0; aspect-ratio: 1; overflow: hidden; background: var(--n-carbon); }
  .nt-img img { width: 100%; height: 100%; object-fit: cover; }
  .nt-comp { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; }
  .nt-comp > span { margin-right: 4px; }
  .nt-comp a { display: grid; place-items: center; width: 44px; height: 44px; border: 2px solid var(--n-noche); color: var(--n-noche); transition: background-color var(--mk-t-rapida), color var(--mk-t-rapida); }
  .nt-comp svg { width: 20px; height: 20px; }
  .nt-comp a:hover { background: var(--n-noche); color: var(--n-amarillo); }

  /* Cuerpo: columna de lectura */
  .nt-cuerpo { max-width: 720px; margin-inline: auto; font-size: 19px; line-height: 1.75; color: var(--n-noche); }
  .nt-cuerpo :global(p) { margin: 0 0 1.2em; }
  .nt-cuerpo :global(h2) { margin: 1.6em 0 .6em; font-size: 28px; line-height: 1.2; font-weight: 700; }
  .nt-cuerpo :global(h3), .nt-cuerpo :global(h4) { margin: 1.4em 0 .5em; font-size: 22px; line-height: 1.25; font-weight: 700; }
  .nt-cuerpo :global(ul), .nt-cuerpo :global(ol) { margin: 0 0 1.2em; padding-left: 0; }
  .nt-cuerpo :global(li) { position: relative; padding-left: 22px; margin-bottom: .5em; }
  .nt-cuerpo :global(ul > li::before) { content: ""; position: absolute; left: 0; top: .7em; width: 8px; height: 8px; background: var(--n-lavanda); }
  .nt-cuerpo :global(ol) { counter-reset: n; }
  .nt-cuerpo :global(ol > li::before) { counter-increment: n; content: counter(n) "."; position: absolute; left: 0; font-weight: 700; }
  .nt-cuerpo :global(a) { color: var(--n-noche); font-weight: 600; text-decoration: underline; text-decoration-color: var(--n-lavanda-osc); text-decoration-thickness: 2px; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .nt-cuerpo :global(a:hover) { background: var(--n-amarillo); }
  .nt-cuerpo :global(img) { display: block; width: 100%; height: auto; margin: 1.6em 0; }
  .nt-cuerpo :global(blockquote) { margin: 1.6em 0; padding: 4px 0 4px 24px; border-left: 4px solid var(--n-lavanda); font-size: 22px; line-height: 1.5; font-weight: 600; }
  .nt-cuerpo :global(strong) { font-weight: 700; }
  .nt-pie { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px 32px; max-width: 720px; margin: 48px auto 0; padding-top: 24px; border-top: 2px solid var(--n-noche); }
  .nt-pie .n-a :global(.mk-ic) { order: -1; }

  .nt-rel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .nt-rel :global(.nno) { background: #fff; }

  @media (max-width: 1024px) {
    .nt-hero-in { grid-template-columns: 1fr; gap: 32px; }
    .nt-img { max-width: 480px; }
    .nt-h1 { font-size: 38px; }
    .nt-rel { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .nt-hero { padding-block: 24px 40px; }
    .nt-h1 { font-size: 30px; }
    .nt-lead { font-size: 18px; }
    .nt-cuerpo { font-size: 17px; }
    .nt-cuerpo :global(h2) { font-size: 24px; }
    .nt-rel { grid-template-columns: 1fr; }
  }
</style>
