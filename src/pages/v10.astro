---
/* V10 · P3 Bandas de color: cada sección con su fondo de la paleta (hueso, blanco, amarillo, cyan claro,
   lavanda claro, salmón claro), listas grandes separadas por líneas de 1.5 px y fotos rectas.
   El botón del menú va en violeta porque la agenda ya es una banda amarilla. */
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PHeader from '../components/p/PHeader.astro';
import PHero from '../components/p/PHero.astro';
import PCard from '../components/p/PCard.astro';
import PLink from '../components/p/PLink.astro';
import PFooter from '../components/p/PFooter.astro';
import PBarra from '../components/p/PBarra.astro';
import Icon from '../components/ui/Icon.astro';
import d from '../data/propuestas/home.json';
import { img } from '../lib/images.js';
import { ruta } from '../lib/rutas.js';
import { url } from '../lib/url.js';
import '../styles/propuestas.css';
const [domo, salas, labs, digital] = d.vive.items;
const chicas = [digital, salas, labs];
const [n1, ...nResto] = d.noticias.items;
const P = (src, alt, w, sizes) => ({ src: img(src), alt, formats: ['avif', 'webp'], widths: w, sizes, loading: 'lazy' });
---
<Base title="Maloka · Centro interactivo de ciencia y tecnología en Bogotá" description="Atrévete a vivir la ciencia en Maloka, Bogotá: Cine Domo, salas interactivas, laboratorios, programación y visitas en grupo. Horarios, cómo llegar y compra de entradas." precargarHero clase="pp">
  <PHeader variante="blanco" inicio={url('v10/')} />
  <main id="contenido">
    <PHero variante="p3" />

    <section class="p3-planea" aria-labelledby="p3-pl-t">
      <div class="mk-w p3-planea-in">
        <h2 class="pp-h2 p3-h2s" id="p3-pl-t">{d.planea.titulo}</h2>
        <ul class="p3-planea-l">
          {d.planea.items.map((it) => <li><a href={ruta(it.titulo)}><b>{it.titulo}</b><span>{it.texto}</span></a></li>)}
        </ul>
      </div>
    </section>

    <section class="pp-banda" aria-labelledby="p3-vi-t">
      <div class="mk-w">
        <div class="pp-head"><h2 class="pp-h2" id="p3-vi-t">{d.vive.titulo}</h2><PLink texto={d.vive.enlace} /></div>
        <div class="p3-vive">
          <a class="p3-vg" href={ruta('Ver funciones')}>
            <span class="pp-foto" style="aspect-ratio:4/3"><Picture {...P(domo.imagen, domo.alt, [480, 750], '(max-width: 1024px) 92vw, 720px')} /><span class="pp-et p3-et" style={`background:var(--mk-${domo.color})`}>{domo.etiqueta}</span></span>
            <h3 class="p3-vg-t">{domo.titulo}</h3>
            <span class="pp-muted">{domo.corto}</span>
          </a>
          <ul class="p3-vc">
            {chicas.map((it) => (
              <li><a href={ruta(it.etiqueta)}>
                <span class="pp-foto" style="aspect-ratio:1/1"><Picture {...P(it.imagenChica ?? it.imagen, it.altChica ?? it.alt, [342, 560], '200px')} /></span>
                <span class="p3-vc-x"><span class="p3-cat" style={`color:var(--mk-${it.colorTexto})`}>{it.categoria}</span><h3 class="p3-vc-t">{it.etiqueta}</h3><span class="pp-muted">{it.corto}</span></span>
              </a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pp-banda p3-amarillo" aria-labelledby="p3-ag-t">
      <div class="mk-w">
        <div class="pp-head"><h2 class="pp-h2" id="p3-ag-t">{d.agenda.tituloCorto}</h2><PLink texto={d.agenda.enlace} /></div>
        <ul class="p3-grid4 mk-carrusel">
          {d.agenda.items.map((a) => <li><PCard image={a.imagen} alt={a.alt} day={a.dia} monthTime={`${a.mes} · ${a.hora}`} title={a.titulo} meta={`${a.lugar} · ${a.costo}`} href={ruta('Toda la programación')} /></li>)}
        </ul>
        <span class="pp-ej p3-ej-blanco">Programación de ejemplo</span>
      </div>
    </section>

    <section class="pp-banda p3-cyan" aria-labelledby="p3-gr-t">
      <div class="mk-w p3-gr">
        <div class="p3-gr-x">
          <h2 class="pp-h2" id="p3-gr-t">{d.grupos.eyebrow}</h2>
          <p class="pp-lead">{d.grupos.titulo} {d.grupos.texto}</p>
          <span class="pp-foto" style="aspect-ratio:4/3"><Picture {...P(d.grupos.imagen, d.grupos.alt, [342], '(max-width: 1024px) 92vw, 460px')} /></span>
        </div>
        <ul class="p3-filas">
          {d.grupos.items.map((g) => (
            <li><a href={ruta(g.titulo)}>
              <Icon name={g.icono} size="28" />
              <span class="p3-fila-x"><b>{g.titulo}</b><span>{g.texto}</span></span>
              <span class:list={['pp-foto p3-fila-f', g.recorte && 'p3-fila-f--recorte']}><Picture {...P(g.imagen, '', [342, 476], '200px')} /></span>
              <Icon name="arrow" />
            </a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="pp-banda p3-lavanda" aria-labelledby="p3-de-t">
      <div class="mk-w p3-de">
        <span class="pp-foto" style="aspect-ratio:1/1"><Picture {...P(d.descubre.imagen, d.descubre.alt, [342], '(max-width: 1024px) 92vw, 600px')} /></span>
        <div class="p3-de-x">
          <p class="pp-eb">{d.descubre.eyebrow}</p>
          <h2 class="pp-h2" id="p3-de-t">{d.descubre.tituloLargo}</h2>
          <ul class="p3-cifras">{d.descubre.cifras.map((c) => <li><b class="t-num">{c.valor}</b><span>{c.label}</span></li>)}</ul>
          <span class="pp-ej p3-ej">Cifras por validar</span>
          <div class="p3-links">{d.descubre.enlaces.map((e) => <PLink texto={e} />)}</div>
        </div>
      </div>
    </section>

    <section class="pp-banda p3-salmon" aria-labelledby="p3-cr-t">
      <div class="mk-w p3-cr">
        <div class="p3-cr-x"><h2 class="pp-h2" id="p3-cr-t">{d.crea.eyebrow}</h2><p class="pp-lead">{d.crea.titulo} {d.crea.texto}</p><PLink texto={d.crea.enlace} /></div>
        <ul class="pp-lista p3-cr-l">{d.crea.items.map((c) => <li><a href={ruta(c)}>{c}<Icon name="arrow" /></a></li>)}</ul>
      </div>
    </section>

    <section class="pp-banda" aria-labelledby="p3-no-t">
      <div class="mk-w">
        <div class="pp-head"><h2 class="pp-h2" id="p3-no-t">{d.noticias.titulo}</h2><PLink texto={d.noticias.enlace} /></div>
        <ul class="p3-no">
          <li><PCard image={n1.imagen} alt={n1.alt} day={n1.dia} monthTime={n1.mes} title={n1.titulo} description={n1.texto} ratio="16 / 10" titleSize={24} href={ruta('Ver todas')} sizes="(max-width: 767px) 92vw, 640px" /></li>
          {nResto.map((n) => <li><PCard image={n.imagen} alt={n.alt} day={n.dia} monthTime={n.mes.replace(' 2026', '')} title={n.titulo} titleSize={18} href={ruta('Ver todas')} sizes="(max-width: 767px) 92vw, 300px" /></li>)}
        </ul>
        <span class="pp-ej">Noticias de ejemplo</span>
      </div>
    </section>
  </main>
  <PFooter />
  <PBarra actual="v10" />
</Base>

<style>
  .p3-planea { background: var(--mk-hueso); }
  .p3-planea-in { display: grid; grid-template-columns: 4fr 8fr; gap: 32px 56px; padding-block: 64px; }
  .p3-h2s { font-size: 40px; }
  .p3-planea-l { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 40px; }
  .p3-planea-l a { display: grid; gap: 6px; padding-top: 14px; border-top: 1.5px solid var(--mk-texto); color: var(--mk-texto); }
  .p3-planea-l b { font-size: 18px; }
  .p3-planea-l span { font-size: 14px; color: var(--mk-texto-2); }
  .p3-planea-l a:hover b { text-decoration: underline; text-underline-offset: 4px; }

  .p3-vive { display: grid; grid-template-columns: 7fr 5fr; gap: 24px; }
  .p3-vg { display: flex; flex-direction: column; gap: 14px; color: var(--mk-texto); }
  .p3-et { position: absolute; left: 0; top: 0; height: 28px; }
  .p3-vg-t { margin: 0; font-size: 28px; line-height: 1.2; font-weight: 700; }
  .p3-vc { display: grid; gap: 24px; align-content: start; }
  .p3-vc a { display: grid; grid-template-columns: 200px 1fr; gap: 20px; align-items: start; color: var(--mk-texto); }
  .p3-vc-x { display: grid; gap: 6px; }
  .p3-cat { font-size: 12px; font-weight: 700; }
  .p3-vc-t { margin: 0; font-size: 20px; font-weight: 700; }
  .p3-vc-x .pp-muted { font-size: 14px; }
  .p3-vg :global(img), .p3-vc :global(img), .p3-filas :global(img) { transition: transform 300ms var(--mk-ease); }
  .p3-vg:hover :global(img), .p3-vc a:hover :global(img), .p3-filas a:hover :global(img) { transform: scale(1.04); }

  .p3-amarillo { background: var(--mk-amarillo-500); }
  .p3-grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .p3-amarillo :global(.pc-m) { font-weight: 400; }
  .p3-ej-blanco { background: #fff; }

  .p3-cyan { background: var(--mk-cyan-100); }
  .p3-gr { display: grid; grid-template-columns: 5fr 7fr; gap: 40px 64px; align-items: start; }
  .p3-gr-x { display: flex; flex-direction: column; gap: 20px; }
  .p3-filas { border-top: 1.5px solid var(--mk-texto); }
  .p3-filas a { display: grid; grid-template-columns: 48px 1fr 200px 24px; gap: 24px; align-items: center; padding-block: 20px; border-bottom: 1.5px solid var(--mk-texto); color: var(--mk-texto); }
  .p3-fila-x { display: grid; gap: 2px; }
  .p3-fila-x b { font-size: 22px; line-height: 1.25; }
  .p3-fila-x span { font-size: 14px; }
  .p3-fila-f { aspect-ratio: 3 / 2; }
  .p3-fila-f--recorte { background: var(--mk-amarillo-500); }
  .p3-fila-f--recorte :global(img) { object-fit: contain; object-position: center bottom; }

  .p3-lavanda { background: var(--mk-lavanda-50); }
  .p3-de { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 64px; align-items: center; }
  .p3-de-x { display: flex; flex-direction: column; gap: 22px; }
  .p3-cifras { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding-top: 20px; border-top: 1.5px solid var(--mk-texto); }
  .p3-cifras li { display: grid; }
  .p3-cifras b { font-size: 56px; line-height: 1; font-weight: 700; }
  .p3-cifras span { font-size: 14px; }
  .p3-ej { margin-top: 0; align-self: flex-start; }
  .p3-links { display: flex; flex-wrap: wrap; gap: 12px 28px; }

  .p3-salmon { background: var(--mk-salmon-50); }
  .p3-cr { display: grid; grid-template-columns: 5fr 7fr; gap: 40px 64px; align-items: start; }
  .p3-cr-x { display: flex; flex-direction: column; gap: 20px; }
  .p3-cr-l a { font-size: 24px; min-height: 72px; }

  .p3-no { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 24px; align-items: start; }

  @media (max-width: 1024px) {
    .p3-planea-in, .p3-vive, .p3-gr, .p3-de, .p3-cr { grid-template-columns: 1fr; }
    .p3-grid4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .p3-no { grid-template-columns: 1fr 1fr; }
    .p3-no li:first-child { grid-column: 1 / -1; }
    .p3-h2s { font-size: var(--pp-h2); }
  }
  @media (max-width: 767px) {
    .p3-planea-in { padding-block: 48px; }
    .p3-planea-l { grid-template-columns: 1fr; gap: 20px; }
    .p3-vc a { grid-template-columns: 120px 1fr; gap: 16px; }
    .p3-filas a { grid-template-columns: 32px 1fr 24px; gap: 14px; }
    .p3-fila-f { display: none; }
    .p3-fila-x b { font-size: 18px; }
    .p3-cr-l a { font-size: 19px; min-height: 60px; }
    .p3-cifras b { font-size: 44px; }
    .p3-no { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .p3-vg:hover :global(img), .p3-vc a:hover :global(img), .p3-filas a:hover :global(img) { transform: none; } }
</style>
