---
/* Índice del prototipo: miniaturas y enlaces a las versiones del home, en orden. */
import Base from '../layouts/Base.astro';
import Logo from '../components/ui/Logo.astro';
import Icon from '../components/ui/Icon.astro';
import data from '../data/variantes.json';
import { url } from '../lib/url.js';
---
<Base title="Prototipo de la home de Maloka · versiones" description="Versiones navegables de la home de maloka.org, en orden, para comparar en el navegador.">
  <header class="ix-top mk-w">
    <span class="ix-logo"><Logo size={56} /></span>
    <div>
      <p class="t-eyebrow">Prototipo navegable</p>
      <h1 class="t-h1">Home de Maloka · versiones</h1>
      <p class="t-lead">Todas las versiones de la home, en orden. La barra de abajo de cada versión salta entre ellas.</p>
    </div>
  </header>
  <main id="contenido" class="mk-w ix-main">
    <ul class="ix-grid">
      {data.items.map((v) => (
        <li>
          <a class="ix-card" href={url(v.ruta)}>
            <span class="ix-thumb"><img src={url(`miniaturas/${v.id}.jpg`)} alt="" width="720" height="900" loading="lazy" /></span>
            <span class="ix-txt">
              <h2 class="t-h4">{v.nombre}</h2>
              <span class="t-small t-muted">{v.descripcion}</span>
              <span class="mk-enlace">Ver {v.etiqueta}<Icon name="arrow" size="18" /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .ix-top { display: flex; gap: 24px; align-items: flex-start; padding-block: 56px 40px; }
  .ix-logo { color: var(--mk-violeta-700); flex: none; }
  .ix-top > div { display: grid; gap: 12px; }
  .ix-main { padding-bottom: 96px; display: grid; gap: 48px; }
  .ix-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .ix-card { display: grid; gap: 16px; border-radius: var(--mk-r-28); color: var(--mk-texto); }
  .ix-card:focus-visible { outline-offset: 6px; }
  .ix-thumb { display: block; aspect-ratio: 4 / 5; border-radius: var(--mk-r-20); overflow: hidden; border: 1px solid var(--mk-borde); background: var(--mk-fondo-alt); transition: box-shadow var(--mk-t) var(--mk-ease); }
  .ix-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .ix-card:hover .ix-thumb { box-shadow: var(--mk-sombra-2); }
  .ix-txt { display: grid; gap: 6px; }
  @media (max-width: 1099px) { .ix-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) { .ix-grid { grid-template-columns: 1fr; } .ix-top { flex-direction: column; } }
</style>
