---
/* Home para WordPress + Elementor: misma información y Design System, armada solo con contenedores y widgets
   nativos de Elementor Pro (Menú, Loop Grid, Filtro de taxonomía, Icon Box, Icon List, Formulario).
   La guía de construcción está en /elementor/guia. */
import Base from '../layouts/Base.astro';
import ElHeader from '../components/elementor/ElHeader.astro';
import ElHero from '../components/elementor/ElHero.astro';
import ElPlanea from '../components/elementor/ElPlanea.astro';
import ElExperiencias from '../components/elementor/ElExperiencias.astro';
import ElAgenda from '../components/elementor/ElAgenda.astro';
import ElGrupos from '../components/elementor/ElGrupos.astro';
import ElDescubre from '../components/elementor/ElDescubre.astro';
import ElCrea from '../components/elementor/ElCrea.astro';
import ElNoticias from '../components/elementor/ElNoticias.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/elementor.css';
---
<Base title="Maloka · Centro interactivo de ciencia y tecnología en Bogotá" description="Atrévete a vivir la ciencia en Maloka, Bogotá: Cine Domo, salas interactivas, laboratorios, programación y visitas en grupo. Horarios, cómo llegar y compra de entradas." variante="v5" precargarHero clase="el">
  <ElHeader />
  <main id="contenido">
    <ElHero />
    <ElPlanea />
    <ElExperiencias />
    <ElAgenda />
    <ElGrupos />
    <ElDescubre />
    <ElCrea />
    <ElNoticias />
  </main>
  <Footer />
</Base>
