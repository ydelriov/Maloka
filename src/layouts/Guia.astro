---
/* Layout de la guía de construcción en Elementor (página Markdown). */
import Base from './Base.astro';
import Logo from '../components/ui/Logo.astro';
import { url } from '../lib/url.js';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description} variante="elementor">
  <header class="gu-top mk-w">
    <a href={url('elementor/')} class="gu-logo" aria-label="Volver a la variante Elementor"><Logo size={44} /></a>
  </header>
  <main id="contenido" class="mk-w gu"><slot /></main>
</Base>
<style>
  .gu-top { padding-block: 24px; }
  .gu-logo { display: inline-flex; color: var(--mk-violeta-700); border-radius: 8px; }
  .gu { max-width: calc(880px + 2 * var(--mk-margen)); padding-bottom: 120px; }
  .gu :global(h1) { font-size: var(--mk-h1); line-height: 1.1; font-weight: 700; letter-spacing: -.02em; margin-bottom: 16px; }
  .gu :global(h2) { font-size: var(--mk-h3); line-height: 1.25; font-weight: 700; margin: 56px 0 16px; padding-top: 24px; border-top: 1px solid var(--mk-borde); }
  .gu :global(h3) { font-size: var(--mk-h5); font-weight: 700; margin: 32px 0 10px; color: var(--mk-violeta-700); }
  .gu :global(p), .gu :global(li) { color: var(--mk-texto-2); }
  .gu :global(p) { margin-bottom: 12px; }
  .gu :global(strong) { color: var(--mk-texto); font-weight: 600; }
  .gu :global(ul), .gu :global(ol) { padding-left: 22px; margin-bottom: 16px; display: grid; gap: 6px; }
  .gu :global(ul) { list-style: disc; }
  .gu :global(ol) { list-style: decimal; }
  .gu :global(li ul) { margin: 6px 0 0; list-style: circle; }
  .gu :global(a) { color: var(--mk-enlace); font-weight: 600; text-decoration: underline; }
  .gu :global(code) { font-size: .9em; padding: 1px 6px; border-radius: 6px; background: var(--mk-fondo-tonal); color: var(--mk-violeta-800); }
  .gu :global(pre) { padding: 16px; border-radius: var(--mk-r-14); background: var(--mk-neutro-900); color: #fff; overflow-x: auto; margin-bottom: 16px; }
  .gu :global(pre code) { background: none; color: inherit; padding: 0; }
  .gu :global(table) { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px; display: block; overflow-x: auto; }
  .gu :global(th), .gu :global(td) { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid var(--mk-borde); }
  .gu :global(th) { font-weight: 700; color: var(--mk-texto); background: var(--mk-fondo-alt); }
  .gu :global(td) { color: var(--mk-texto-2); }
</style>
