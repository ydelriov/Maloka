---
/* Header de las propuestas. Un solo botón en la página: «Compra tus entradas» (amarillo en P1 y P2, violeta en P3).
   variante: «sobre» (P1, blanco sobre el banner) · «hueso» (P2) · «blanco» (P3).
   ≤ 1100 px: logo, botón y menú a pantalla completa con acordeones, horario de hoy, botón fijo abajo,
   trampa de foco y cierre con Esc. */
import nav from '../../data/nav.json';
import site from '../../data/site.json';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import EstadoHoy from '../ui/EstadoHoy.astro';
import { ruta } from '../../lib/rutas.js';
const { variante = 'blanco', inicio = '#' } = Astro.props;
const boton = variante === 'blanco' ? 'violeta' : 'amarillo';
---
<header class:list={['ph', `ph--${variante}`]}>
  <div class="mk-w ph-bar">
    <a class:list={['ph-logo', variante === 'hueso' && 'ph-logo--movil']} href={inicio} aria-label="Maloka, ir al inicio"><Logo size={variante === 'sobre' ? 42 : 40} /></a>
    <nav class="ph-nav" aria-label="Principal">
      {variante === 'sobre' && <button type="button" class="ph-ic" aria-label="Buscar"><Icon name="search" /></button>}
      <ul class="ph-list">{nav.items.map((it) => <li><a href={ruta(it.label)}>{it.label}</a></li>)}</ul>
      {variante === 'hueso' && <><a class="ph-lang" href="#" aria-label="Idioma: español. Cambiar a inglés">ES | EN</a><button type="button" class="ph-ic" aria-label="Buscar"><Icon name="search" /></button></>}
    </nav>
    <div class="ph-acc">
      {variante === 'blanco' && <button type="button" class="ph-ic ph-desk" aria-label="Buscar"><Icon name="search" /></button>}
      {variante === 'blanco' && <a class="ph-lang ph-desk" href="#" aria-label="Idioma: español. Cambiar a inglés">ES</a>}
      {variante === 'sobre' && <a class="ph-lang ph-desk" href="#" aria-label="Idioma: español. Cambiar a inglés">ES · EN</a>}
      <a class:list={['ph-btn', `ph-btn--${boton}`]} href={site.entradas.url} target="_blank" rel="noopener">{site.entradas.texto}<span class="sr-only"> (se abre en otra pestaña)</span></a>
      <button type="button" class="ph-ic ph-burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="pp-menu" data-pm-abrir><Icon name="menu" /></button>
    </div>
  </div>
</header>

<div class="pm" id="pp-menu" role="dialog" aria-modal="true" aria-label="Menú" hidden data-pm>
  <div class="pm-top mk-w">
    <a class="pm-logo" href={inicio} aria-label="Maloka, ir al inicio"><Logo size={36} /></a>
    <button type="button" class="ph-ic" aria-label="Cerrar menú" data-pm-cerrar><Icon name="close" /></button>
  </div>
  <div class="pm-body mk-w">
    <EstadoHoy />
    <ul class="pm-list">
      {nav.items.map((it) => (
        <li>
          {it.links.length > 1 ? (
            <>
              <button type="button" class="pm-trig" aria-expanded="false" aria-controls={`pm-${it.id}`}>{it.label}<Icon name="down" class="pm-chev" /></button>
              <ul class="pm-sub" id={`pm-${it.id}`} hidden>{it.links.map((l) => <li><a href={ruta(l.label)}>{l.label}</a></li>)}</ul>
            </>
          ) : <a class="pm-trig" href={ruta(it.label)}>{it.label}</a>}
        </li>
      ))}
    </ul>
    <p class="pm-dato"><Icon name="pin" size="20" />{site.direccion}</p>
    <p class="pm-dato"><Icon name="phone" size="20" />{site.telefono}</p>
  </div>
  <div class="pm-cta mk-w">
    <a class:list={['ph-btn', `ph-btn--${boton}`, 'ph-btn--bloque']} href={site.entradas.url} target="_blank" rel="noopener">{site.entradas.texto}<span class="sr-only"> (se abre en otra pestaña)</span></a>
  </div>
</div>

<style>
  .ph { position: relative; z-index: 50; color: var(--mk-texto); }
  .ph--sobre { position: absolute; left: 0; right: 0; top: 0; color: #fff; }
  .ph--hueso { background: var(--mk-hueso); }
  .ph--blanco { background: #fff; border-bottom: 1px solid var(--mk-borde); }
  .ph-bar { display: flex; align-items: center; gap: 28px; height: 88px; }
  .ph--hueso .ph-bar { height: 112px; }
  .ph--blanco .ph-bar { height: 84px; }
  .ph-logo { display: inline-flex; color: currentColor; flex: none; }
  .ph--blanco .ph-logo { color: var(--mk-texto); }
  .ph-logo--movil { display: none; }
  .ph-nav { display: flex; align-items: center; gap: 24px; flex: 1; }
  .ph-list { display: flex; align-items: center; gap: 28px; font-size: 15px; font-weight: 600; }
  .ph--hueso .ph-list { font-size: 16px; gap: 30px; }
  .ph-list a, .ph-lang { display: inline-flex; align-items: center; min-height: 44px; color: inherit; white-space: nowrap; font-size: 15px; font-weight: 600; }
  .ph-list a:hover, .ph-lang:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .ph-ic { display: inline-grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; background: none; color: inherit; cursor: pointer; }
  .ph-acc { display: flex; align-items: center; gap: 20px; margin-left: auto; }
  .ph-btn { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 20px; border-radius: var(--mk-r-pill); font-size: 15px; font-weight: 700; white-space: nowrap; }
  .ph-btn--amarillo { background: var(--mk-amarillo-500); color: var(--mk-violeta-900); }
  .ph-btn--amarillo:hover { background: #D3BB03; }
  .ph-btn--violeta { background: var(--mk-violeta-700); color: #fff; }
  .ph-btn--violeta:hover { background: var(--mk-violeta-800); }
  .ph-btn--bloque { width: 100%; height: 52px; }
  .ph--sobre :focus-visible { outline: var(--mk-foco-oscuro); }
  .ph-burger { display: none; }

  .pm { position: fixed; inset: 0; z-index: 200; display: flex; flex-direction: column; background: #fff; color: var(--mk-texto); }
  .pm[hidden] { display: none; }
  .pm-top { display: flex; align-items: center; justify-content: space-between; height: 72px; flex: none; border-bottom: 1px solid var(--mk-borde); }
  .pm-logo { display: inline-flex; color: var(--mk-texto); }
  .pm-body { flex: 1; overflow-y: auto; display: grid; gap: 16px; align-content: start; padding-block: 20px; }
  .pm-body :global(.mk-hoy) { border-radius: 0; justify-self: start; }
  .pm-list { border-top: 1.5px solid var(--mk-texto); }
  .pm-list > li { border-bottom: 1.5px solid var(--mk-texto); }
  .pm-trig { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 64px; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-size: 22px; font-weight: 700; text-align: left; cursor: pointer; }
  .pm-trig :global(.pm-chev) { transition: transform var(--mk-t-rapida); }
  .pm-trig[aria-expanded="true"] :global(.pm-chev) { transform: rotate(180deg); }
  .pm-sub { display: grid; padding-bottom: 12px; }
  .pm-sub a { display: flex; align-items: center; min-height: 44px; font-size: 17px; font-weight: 600; color: var(--mk-texto-2); }
  .pm-dato { display: flex; gap: 10px; align-items: center; font-size: 14px; color: var(--mk-texto-2); }
  .pm-dato :global(.mk-ic) { color: var(--mk-violeta-700); }
  .pm-cta { flex: none; padding-block: 12px calc(12px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--mk-borde); }

  @media (max-width: 1100px) {
    .ph-nav, .ph-desk { display: none; }
    .ph-logo--movil { display: inline-flex; }
    .ph-burger { display: inline-grid; }
    .ph-bar, .ph--hueso .ph-bar, .ph--blanco .ph-bar { height: 72px; }
    .ph-acc { gap: 8px; }
  }
  @media (max-width: 399px) { .ph-btn:not(.ph-btn--bloque) { padding: 0 14px; font-size: 14px; } }
</style>

<script>
  const panel = document.querySelector('[data-pm]');
  const abrir = document.querySelector('[data-pm-abrir]');
  const cerrar = panel.querySelector('[data-pm-cerrar]');
  const fuera = () => [...document.body.children].filter((el) => el !== panel && el.tagName !== 'SCRIPT');
  const enfocables = () => [...panel.querySelectorAll('a[href], button')].filter((el) => el.offsetParent !== null);
  function abrirMenu() {
    panel.hidden = false; abrir.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden'; fuera().forEach((el) => el.setAttribute('inert', ''));
    cerrar.focus();
  }
  function cerrarMenu() {
    panel.hidden = true; abrir.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = ''; fuera().forEach((el) => el.removeAttribute('inert'));
    abrir.focus();
  }
  abrir.addEventListener('click', abrirMenu);
  cerrar.addEventListener('click', cerrarMenu);
  panel.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { cerrarMenu(); return; }
    if (e.key !== 'Tab') return;
    const f = enfocables(), a = f[0], z = f[f.length - 1];
    if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); }
    else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
  });
  panel.querySelectorAll('button[aria-controls]').forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    document.getElementById(b.getAttribute('aria-controls')).hidden = open;
  }));
  window.matchMedia('(min-width: 1101px)').addEventListener('change', (e) => { if (e.matches && !panel.hidden) cerrarMenu(); });
</script>
