---
/* Foto a sangre con velo plano en la mitad inferior, etiqueta de color, título y una línea. Toda la foto es el enlace,
   salvo que lleve enlaces propios en el slot (entonces la foto es un contenedor). */
import { Picture } from 'astro:assets';
import { img } from '../../lib/images.js';
const { image, alt = '', etiqueta, color, titulo, texto, href, alto = 640, sizes = '100vw', nivel = 3, class: cls = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
const H = `h${nivel}`;
const conSlot = Astro.slots.has('default');
---
<Tag class:list={['pt mk-sobre-foto', cls]} href={href} style={`--pt-h:${alto}px`}>
  <Picture src={img(image)} alt={alt} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes={sizes} class="pt-img" loading="lazy" decoding="async" />
  <span class="pt-velo" aria-hidden="true"></span>
  <span class:list={['pt-cap mk-w', conSlot && 'pt-cap--ancho']}>
    {etiqueta && <span class="pp-et" style={`background:var(--mk-${color})`}>{etiqueta}</span>}
    <H class="pt-t">{titulo}</H>
    {texto && <span class="pt-x">{texto}</span>}
    <slot />
  </span>
</Tag>

<style>
  .pt { position: relative; display: flex; align-items: flex-end; height: var(--pt-h); overflow: hidden; color: #fff; background: var(--mk-hero-fondo); }
  .pt :global(picture), .pt :global(.pt-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pt :global(.pt-img) { transition: transform 300ms var(--mk-ease); }
  a.pt:hover :global(.pt-img) { transform: scale(1.04); }
  a.pt:focus-visible { outline: var(--mk-foco); outline-offset: -6px; }
  .pt-velo { position: absolute; left: 0; right: 0; bottom: 0; height: 50%; background: var(--mk-velo); }
  .pt-cap { position: relative; display: flex; flex-direction: column; gap: 10px; padding-bottom: 56px; max-width: calc(640px + 2 * var(--mk-margen)); margin-left: 0; }
  .pt-cap--ancho { max-width: calc(var(--mk-contenedor) + 2 * var(--mk-margen)); margin-inline: auto; }
  .pt-t { margin: 0; font-size: 32px; line-height: 1.15; font-weight: 700; letter-spacing: -0.01em; }
  .pt-x { font-size: 17px; line-height: 1.5; color: var(--mk-hueso); }
  @media (max-width: 1024px) { .pt { height: calc(var(--pt-h) * .75); } }
  @media (max-width: 767px) { .pt { height: 440px; } .pt-t { font-size: 26px; } .pt-cap { padding-bottom: 32px; } .pt-x { font-size: 16px; } .pt-velo { height: 65%; } }
  @media (prefers-reduced-motion: reduce) { a.pt:hover :global(.pt-img) { transform: none; } }
</style>
