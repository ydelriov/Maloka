---
/* Empresas y eventos: propuesta, dato de confianza y espacios. En Elementor: encabezado + grid de tarjetas de espacio. */
import { Picture } from 'astro:assets';
import d from '../../data/ven-en-grupo.json';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PorValidar from '../ui/PorValidar.astro';
import { img } from '../../lib/images.js';
const e = d.empresas;
---
<section class="gem mk-seccion" id="empresas" aria-labelledby="gem-t">
  <div class="mk-w">
    <div class="gem-head" data-el="Contenedor grid · 2 col">
      <div class="el-head-txt">
        <p class="t-eyebrow">Empresas y eventos</p>
        <h2 class="t-h2" id="gem-t">{e.titulo}</h2>
      </div>
      <div class="gem-intro">
        <p class="t-lead">{e.texto}</p>
        <p class="gem-dato"><Icon name="building" size="20" /><span>{e.dato}</span></p>
      </div>
    </div>
    <ul class="gem-grid" data-el="Contenedor grid · 2 / 2 / 1 col · tarjetas de espacio">
      {e.espacios.map((s) => (
        <li class="gem-esp">
          <div class="gem-media"><Picture src={img(s.imagen)} alt={s.alt} formats={['avif', 'webp']} widths={[342, 560, 794]} sizes="(max-width: 767px) 92vw, 620px" class="gem-img" loading="lazy" /></div>
          <div class="gem-body"><h3 class="t-h4">{s.titulo}</h3><p>{s.texto}</p></div>
        </li>
      ))}
    </ul>
    <div class="gem-pie">
      <Button href="#cotizar" variant="primario" icon="arrow">Cotiza tu evento</Button>
      <a class="mk-enlace" href="#descargas"><Icon name="download" size="18" />Portafolio de eventos</a>
      <PorValidar texto="Espacios y capacidades por validar" />
    </div>
  </div>
</section>

<style>
  .gem-head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 64px; align-items: end; margin-bottom: 40px; }
  .gem-intro { display: grid; gap: 14px; }
  .gem-dato { display: flex; gap: 10px; align-items: flex-start; padding: 14px 18px; border-radius: var(--mk-r-20); background: var(--mk-fondo-tonal); font-size: var(--mk-small); font-weight: 600; }
  .gem-dato :global(.mk-ic) { color: var(--mk-violeta-700); flex: none; }
  .gem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .gem-esp { border: 1px solid var(--mk-borde); border-radius: var(--mk-r-28); overflow: hidden; }
  .gem-media { position: relative; aspect-ratio: 16 / 9; background: var(--mk-neutro-100); }
  .gem-media :global(picture), .gem-media :global(.gem-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .gem-body { display: grid; gap: 6px; padding: 20px 24px 24px; }
  .gem-body p { font-size: var(--mk-small); color: var(--mk-texto-2); }
  .gem-pie { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 32px; }
  @media (max-width: 1024px) { .gem-head { grid-template-columns: 1fr; } }
  @media (max-width: 767px) { .gem-grid { grid-template-columns: 1fr; } .gem-pie :global(.btn) { width: 100%; } }
</style>
