---
/* Descubre Maloka: programas, recursos y Conoce Maloka como ActionCard + cifras de impacto (por validar).
   V4: tres tarjetas + cifras (05) · V5: bloque violeta con cifras y foto en medio arco · V6: texto + tarjetas. */
import { Picture } from 'astro:assets';
import data from '../../data/descubre.json';
import SectionHead from '../ui/SectionHead.astro';
import ActionCard from '../ui/ActionCard.astro';
import Button from '../ui/Button.astro';
import PorValidar from '../ui/PorValidar.astro';
import { img } from '../../lib/images.js';
const { variante } = Astro.props;
const card = (it) => ({ image: it.imagen, alt: it.alt, category: it.categoria, title: it.titulo, description: it.descripcion, meta: it.meta });
---
<section class:list={['de', `de--${variante}`, 'mk-seccion']} aria-labelledby="de-t">
  <div class="mk-w">
    {variante === 'v4' && (
      <>
        <SectionHead estilo="linea" num="05" eyebrow={data.eyebrow} title={data.titulo} id="de-t">
          <Button slot="accion" href="#" variant="secundario">{data.cta}</Button>
        </SectionHead>
        <ul class="de-grid">{data.items.map((it) => <li><ActionCard {...card(it)} /></li>)}</ul>
        <div class="de-cifras">
          {data.cifras.map((c) => <p><b class="t-num">{c.valor}</b><span>{c.label}</span></p>)}
          <PorValidar texto="Cifras por validar" />
        </div>
      </>
    )}

    {variante === 'v5' && (
      <>
        <div class="de5 mk-oscuro">
          <div class="de5-txt">
            <p class="de5-eb">{data.eyebrow}</p>
            <h2 class="t-h2" id="de-t">{data.titulo}</h2>
            <div class="de5-cifras">
              {data.cifras.map((c) => <p><b class="t-num">{c.valor}</b><span>{c.label}</span></p>)}
              <PorValidar texto="Por validar" />
            </div>
            <Button href="#" variant="invertido">{data.cta}</Button>
          </div>
          <div class="de5-foto">
            <Picture src={img('paramo.jpg')} alt="Páramo con frailejones y una laguna, territorio donde Maloka hace mediación" formats={['avif', 'webp']} widths={[480, 720]} sizes="(max-width: 1099px) 90vw, 460px" class="de5-img" loading="lazy" />
          </div>
        </div>
        <ul class="de-grid de-grid--abajo">{data.items.map((it) => <li><ActionCard {...card(it)} nivel={3} /></li>)}</ul>
      </>
    )}

    {variante === 'v6' && (
      <div class="de6">
        <div class="de6-txt">
          <p class="t-eyebrow">{data.eyebrow}</p>
          <h2 class="t-h2" id="de-t">{data.titulo}</h2>
          <p class="t-lead">{data.texto}</p>
          <Button href="#" variant="secundario">{data.cta}</Button>
        </div>
        <div class="de6-main">
          <ul class="de-grid">{data.items.map((it) => <li><ActionCard {...card(it)} sizes="(max-width: 767px) 92vw, 240px" /></li>)}</ul>
          <div class="de-cifras">
            {data.cifras.map((c) => <p><b class="t-num">{c.valor}</b><span>{c.label}</span></p>)}
            <PorValidar texto="Cifras por validar" />
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .de-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .de-grid--abajo { margin-top: 40px; }
  .de-cifras { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 48px; margin-top: 32px; padding: 24px 28px; border-radius: var(--mk-r-28); background: var(--mk-fondo-tonal); }
  .de-cifras p, .de5-cifras p { display: grid; }
  .de-cifras b { font-size: var(--mk-h2); line-height: 1; font-weight: 700; color: var(--mk-violeta-700); }
  .de-cifras span { font-size: 14px; color: var(--mk-texto-2); }
  .de5 { display: grid; grid-template-columns: 7fr 5fr; align-items: center; border-radius: var(--mk-r-40); overflow: hidden; background: var(--mk-violeta-700); color: #fff; }
  .de5-txt { padding: clamp(28px, 3.9vw, 56px); display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .de5-eb { font-size: 14px; font-weight: 600; color: var(--mk-violeta-200); }
  .de5-cifras { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 40px; }
  .de5-cifras b { font-size: clamp(2.25rem, 1.9rem + 1.4vw, 3rem); line-height: 1; font-weight: 700; }
  .de5-cifras span { font-size: 14px; color: var(--mk-violeta-100); }
  .de5-foto { position: relative; align-self: stretch; margin: 40px 0; min-height: 320px; border-radius: 999px 0 0 999px; overflow: hidden; }
  .de5-foto :global(picture), .de5-foto :global(.de5-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .de6 { display: grid; grid-template-columns: 4fr 8fr; gap: 56px; align-items: start; }
  .de6-txt { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .de6-main .de-cifras { margin-top: 24px; }
  @media (max-width: 1099px) {
    .de5 { grid-template-columns: 1fr; }
    .de5-foto { margin: 0 0 0 clamp(28px, 6vw, 56px); min-height: 240px; }
    .de6 { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 767px) {
    .de-grid { grid-template-columns: 1fr; }
    .de-cifras { gap: 16px 32px; }
  }
</style>
