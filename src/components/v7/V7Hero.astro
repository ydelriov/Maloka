---
/* Hero de V7: banner rotativo con el header transparente encima y el arco blanco de V5 abajo.
   Cada diapositiva trae su imagen, su texto y su propio botón amarillo (solo hay uno visible a la vez).
   La primera usa el banner como fondo; las demás muestran la foto a la derecha en un marco redondeado.
   Fundido de 600 ms, 7 s por diapositiva, botón de pausa; sin movimiento automático con «reducir movimiento».
   En Elementor: widget Carrusel (anidado) con una diapositiva por campaña + botón de pausa en un widget HTML. */
import { Picture } from 'astro:assets';
import data from '../../data/campanas.json';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PorValidar from '../ui/PorValidar.astro';
import { img } from '../../lib/images.js';
const slides = data.slides;
---
<section class="h7 mk-sobre-foto" aria-roledescription="carrusel" aria-label="Destacados de Maloka" data-h7 data-el="Carrusel anidado · 3 diapositivas · Fundido · Autoplay 7 s + pausa">
  {slides.map((s, i) => s.fondo && (
    <div class:list={['h7-bg', i === 0 && 'is-activa']} data-bg={i} aria-hidden="true">
      <Picture src={img(s.imagen)} alt="" formats={['avif', 'webp']} widths={[1024, 1440, 1942]} sizes="100vw" class="h7-bg-img" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
    </div>
  ))}

  <div class="mk-w h7-in">
    <div class="h7-slides">
      {slides.map((s, i) => (
        <div class:list={['h7-slide', s.fondo ? 'h7-slide--fondo' : 'h7-slide--media', i === 0 && 'is-activa']} role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${slides.length}`} aria-hidden={i === 0 ? undefined : 'true'} inert={i === 0 ? undefined : true} data-slide>
          <div class="h7-media">
            <Picture src={img(s.imagen)} alt={s.fondo ? '' : s.alt} formats={['avif', 'webp']} widths={s.fondo ? [640, 960] : [480, 720, 960]} sizes={s.fondo ? '100vw' : '(max-width: 767px) 92vw, 560px'} class="h7-media-img" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          </div>
          <div class="h7-txt">
            <p class="h7-eb">{s.eyebrow}</p>
            {i === 0 ? <h1 class="t-display h7-t">{s.titulo}</h1> : <h2 class="t-display h7-t">{s.titulo}</h2>}
            <p class="h7-lead">{s.lead}</p>
            <div class="h7-ctas">
              <Button href={s.cta.href} variant="destacado" size="lg" icon="arrow" class="btn--movil-bloque">{s.cta.texto}</Button>
              <Button href={s.secundario.href} variant="invertido" size="lg" class="btn--movil-bloque">{s.secundario.texto}</Button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="h7-ctrl">
      <div class="h7-dots" role="group" aria-label="Elegir diapositiva">
        {slides.map((s, i) => (
          <button type="button" class="h7-dot" aria-label={`Ir a la diapositiva ${i + 1}: ${s.eyebrow}`} aria-current={i === 0 ? 'true' : undefined} data-ir={i}></button>
        ))}
      </div>
      <div class="h7-flechas">
        <Button variant="invertido" size="sm" icon="arrowl" label="Diapositiva anterior" data-prev />
        <button type="button" class="btn btn--invertido btn--sm btn--icono" aria-label="Pausar el carrusel" data-pausa>
          <Icon name="pause" class="ic-pausa" /><Icon name="play" class="ic-play" />
        </button>
        <Button variant="invertido" size="sm" icon="arrow" label="Diapositiva siguiente" data-next />
      </div>
      <PorValidar texto="Textos del banner por validar" class="h7-pv" />
    </div>
    <p class="sr-only" aria-live="polite" data-anuncio></p>
  </div>
</section>

<style>
  .h7 { position: relative; overflow: hidden; background: var(--mk-hero-fondo); color: #fff; min-height: 780px; display: flex; align-items: center; padding-block: 128px 224px; }
  /* Arco blanco del domo que cierra el hero (el único arco de esta sección) */
  .h7::after { content: ""; position: absolute; z-index: 1; left: -15%; right: -15%; bottom: -1px; height: 110px; background: #fff; border-radius: 50% 50% 0 0 / 100% 100% 0 0; }

  .h7-bg { position: absolute; inset: 0; opacity: 0; transition: opacity 600ms var(--mk-ease); }
  .h7-bg.is-activa { opacity: 1; }
  .h7-bg :global(picture), .h7-bg :global(.h7-bg-img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .h7-bg :global(.h7-bg-img) { object-fit: cover; object-position: 70% 50%; }

  .h7-in { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 48px; }
  .h7-slides { display: grid; }
  .h7-slide { grid-area: 1 / 1; display: grid; grid-template-columns: 1fr; align-items: center; opacity: 0; visibility: hidden; transition: opacity 600ms var(--mk-ease), visibility 0s linear 600ms; }
  .h7-slide.is-activa { opacity: 1; visibility: visible; transition-delay: 0s; }
  .h7-slide--media { grid-template-columns: 6fr 5fr; gap: 56px; }
  .h7-slide--media .h7-media { order: 2; }
  .h7-slide--fondo .h7-media { display: none; }
  .h7-media { position: relative; aspect-ratio: 4 / 3; border-radius: var(--mk-r-28); overflow: hidden; background: var(--mk-oscuro-superficie); }
  .h7-media :global(picture), .h7-media :global(.h7-media-img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .h7-media :global(.h7-media-img) { object-fit: cover; }
  .h7-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; max-width: 640px; }
  .h7-eb { font-size: 14px; font-weight: 600; color: var(--mk-violeta-200); }
  .h7-t { color: #fff; max-width: 15ch; }
  .h7-lead { font-size: var(--mk-lead); line-height: 1.5; color: #E6DCF0; max-width: 540px; }
  .h7-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .h7-ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .h7-dots { display: flex; gap: 4px; }
  .h7-dot { width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; border-radius: var(--mk-r-pill); }
  .h7-dot::before { content: ""; width: 16px; height: 4px; border-radius: var(--mk-r-pill); background: rgba(255, 255, 255, .45); transition: width var(--mk-t) var(--mk-ease), background-color var(--mk-t); }
  .h7-dot[aria-current="true"]::before { width: 36px; background: #fff; }
  .h7-flechas { display: flex; gap: 8px; }
  .h7 :global(.ic-play) { display: none; }
  .h7.is-pausado :global(.ic-play) { display: block; }
  .h7.is-pausado :global(.ic-pausa) { display: none; }

  @media (max-width: 1024px) {
    .h7 { min-height: 640px; padding-block: 112px 184px; }
    .h7::after { height: 72px; }
    .h7-bg :global(.h7-bg-img) { object-position: 85% 50%; }
    .h7-slide--media { grid-template-columns: 1fr 1fr; gap: 32px; }
    .h7-slide--fondo .h7-lead { max-width: 420px; }
  }
  @media (max-width: 767px) {
    .h7 { min-height: 0; padding-block: 88px 112px; align-items: flex-start; }
    .h7::after { height: 40px; }
    .h7-bg { display: none; }
    .h7-in { gap: 24px; }
    .h7-slide, .h7-slide--media { grid-template-columns: 1fr; gap: 24px; align-items: start; }
    .h7-slide--media .h7-media { order: 0; }
    .h7-slide--fondo .h7-media { display: block; }
    .h7-slide--fondo .h7-media :global(.h7-media-img) { object-position: 74% 50%; }
    .h7-media { aspect-ratio: 16 / 10; border-radius: var(--mk-r-20); }
    .h7-ctas { width: 100%; }
    .h7-ctrl { justify-content: space-between; }
  }
</style>

<script>
  document.querySelectorAll('[data-h7]').forEach((root) => {
    const slides = [...root.querySelectorAll('[data-slide]')];
    const bgs = [...root.querySelectorAll('[data-bg]')];
    const dots = [...root.querySelectorAll('[data-ir]')];
    const pausaBtn = root.querySelector('[data-pausa]');
    const anuncio = root.querySelector('[data-anuncio]');
    let actual = 0, timer = null, pausado = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function mostrar(n, anunciar = true) {
      actual = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === actual;
        s.classList.toggle('is-activa', on);
        if (on) { s.removeAttribute('aria-hidden'); s.inert = false; } else { s.setAttribute('aria-hidden', 'true'); s.inert = true; }
      });
      bgs.forEach((b) => b.classList.toggle('is-activa', +b.dataset.bg === actual));
      dots.forEach((d, i) => (i === actual ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      if (anunciar) anuncio.textContent = `Diapositiva ${actual + 1} de ${slides.length}`;
    }
    const programar = () => { clearInterval(timer); if (!pausado) timer = setInterval(() => mostrar(actual + 1, false), 7000); };
    function setPausa(p) {
      pausado = p;
      root.classList.toggle('is-pausado', p);
      pausaBtn.setAttribute('aria-label', p ? 'Reproducir el carrusel' : 'Pausar el carrusel');
      programar();
    }
    root.querySelector('[data-prev]').addEventListener('click', () => { mostrar(actual - 1); programar(); });
    root.querySelector('[data-next]').addEventListener('click', () => { mostrar(actual + 1); programar(); });
    dots.forEach((d) => d.addEventListener('click', () => { mostrar(+d.dataset.ir); programar(); }));
    pausaBtn.addEventListener('click', () => setPausa(!pausado));
    setPausa(pausado);
  });
</script>
