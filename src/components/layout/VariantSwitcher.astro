---
// Barra flotante solo del prototipo (fuera del diseño): salta entre las versiones del home.
// grupo: muestra solo las versiones de ese grupo (variantes.json › grupos) y enlaza a su propio índice, p. ej. /seleccion/.
// Si el grupo tiene una sola versión, no muestra la barra.
import data from '../../data/variantes.json';
import { url } from '../../lib/url.js';
const { actual, grupo } = Astro.props;
const ids = grupo ? data.grupos[grupo].items : null;
const items = ids ? data.items.filter((v) => ids.includes(v.id)) : data.items;
const pre = grupo ? `${grupo}/` : '';
---
{items.length > 1 && <nav class="vs" aria-label="Versiones del home">
  <a href={url(pre)} aria-current={actual === 'indice' ? 'page' : undefined}>Índice</a>
  {items.map((v) => <a href={url(pre + v.ruta)} aria-current={v.id === actual ? 'page' : undefined}>{v.etiqueta}</a>)}
</nav>}
<style>
  .vs { position: fixed; left: 16px; bottom: 16px; z-index: 150; display: flex; gap: 4px; padding: 4px; border-radius: var(--mk-r-pill); background: var(--mk-neutro-900); box-shadow: var(--mk-sombra-3); font-size: 13px; font-weight: 700; max-width: calc(100vw - 32px); overflow-x: auto; scrollbar-width: none; }
  .vs::-webkit-scrollbar { display: none; }
  .vs a { display: inline-grid; place-items: center; flex: none; min-width: 44px; height: 36px; padding: 0 12px; border-radius: var(--mk-r-pill); color: #fff; }
  .vs a:hover { background: var(--mk-neutro-700); }
  .vs a[aria-current="page"] { background: #fff; color: var(--mk-neutro-900); }
  .vs a:focus-visible { outline: var(--mk-foco-oscuro); outline-offset: 2px; }
  @media (max-width: 767px) { .vs { left: 50%; transform: translateX(-50%); bottom: 12px; } }
</style>
