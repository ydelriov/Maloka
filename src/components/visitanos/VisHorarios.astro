---
/* Horarios y tarifas: lo más importante de la página.
   1. Horarios (datos reales) · 2. Productos con lo que incluyen y la tabla de precios por público (por validar),
   con una sola compra al final para comparar antes de comprar
   · 3. Películas del Cine Domo en modo oscuro · 4. Condiciones de compra.
   En Elementor: grid de 3 Icon Box tonales; Loop Grid de productos (CPT «Producto» con campos de precio);
   contenedor oscuro con Icon List para las películas. */
import { Picture } from 'astro:assets';
import data from '../../data/visitanos.json';
import site from '../../data/site.json';
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
import PorValidar from '../ui/PorValidar.astro';
import EstadoHoy from '../ui/EstadoHoy.astro';
import { img } from '../../lib/images.js';
import { url } from '../../lib/url.js';
const prod = data.productos;
---
<section class="vho mk-seccion" id="horarios" aria-labelledby="vho-t">
  <div class="mk-w">
    <div class="el-head" data-el="Contenedor flex fila · Encabezado + estado de hoy">
      <div class="el-head-txt">
        <p class="t-eyebrow">Horarios y tarifas</p>
        <h2 class="t-h2" id="vho-t">Abrimos todos los días.</h2>
      </div>
      <EstadoHoy />
    </div>

    <ul class="vho-hor" data-el="Contenedor grid · 3 / 3 / 1 col · Icon Box tonal">
      <li>
        <span class="mk-ib vho-ib"><Icon name="clock" /></span>
        <h3 class="t-h5">{site.horarios.semana.dias}</h3>
        <p class="vho-hora t-num">{site.horarios.semana.texto}</p>
      </li>
      <li>
        <span class="mk-ib vho-ib"><Icon name="cal" /></span>
        <h3 class="t-h5">{site.horarios.finde.dias}</h3>
        <p class="vho-hora t-num">{site.horarios.finde.texto}</p>
      </li>
      <li>
        <span class="mk-ib vho-ib"><Icon name="ticket" /></span>
        <h3 class="t-h5">Venta de entradas</h3>
        <p class="vho-hora t-num">Hasta las 4:00 p. m.</p>
      </li>
    </ul>

    <!-- Productos -->
    <div class="vho-prod" id="tarifas">
      <div class="el-head" data-el="Contenedor flex fila · Encabezado + Botón">
        <div class="el-head-txt">
          <p class="t-eyebrow">{prod.eyebrow}</p>
          <h3 class="t-h2">{prod.titulo}</h3>
          <p class="t-muted">{prod.texto}</p>
          <PorValidar texto="Productos y precios por validar" />
        </div>
      </div>
      <ul class="vho-grid" data-el="Loop Grid · 4 / 2 / 1 col · Plantilla «Producto»">
        {prod.items.map((p) => (
          <li class:list={['vp', p.destacado && 'vp--destacado']}>
            <div class="vp-media">
              <Picture src={img(p.imagen)} alt={p.alt} formats={['avif', 'webp']} widths={[360, 560]} sizes="(max-width: 767px) 92vw, (max-width: 1024px) 45vw, 300px" class="vp-img" loading="lazy" />
              <Chip cat={p.categoria} label={p.categoriaLabel} class="vp-chip" />
            </div>
            <div class="vp-body">
              <h4 class="t-h4">{p.titulo}</h4>
              <p class="vp-desc">{p.descripcion}</p>
              <ul class="vp-incluye" aria-label="Incluye">
                {p.incluye.map((x) => <li><Icon name="check" size="18" />{x}</li>)}
              </ul>
              <dl class="vp-precios">
                {prod.publicos.map((pub) => <div><dt>{pub}</dt><dd class="t-num">$ XX.XXX</dd></div>)}
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <div class="vho-compra" data-el="Contenedor flex fila · Texto + Botón primario (única compra de la sección)">
        <p><b>¿Ya elegiste?</b> Compra en línea: eliges la entrada, el día y, si quieres Cine Domo, la función.</p>
        <Button href={site.entradas.url} external variant="primario" size="lg" icon="ext" class="btn--movil-bloque">{site.entradas.texto}</Button>
      </div>
    </div>

    <!-- Cine Domo -->
    <div class="vho-domo mk-oscuro" data-el="Contenedor · Fondo oscuro #140A1F · Radio 28 · Grid 5fr 7fr">
      <div class="vho-domo-txt">
        <Chip cat="cine" label="Cine Domo" />
        <h3 class="t-h2">{data.cartelera.titulo}</h3>
        <p>{data.cartelera.texto}</p>
        <Button href={url('agendate/#programacion')} variant="invertido" icon="arrow">Ver funciones de la semana</Button>
        <PorValidar texto="Cartelera por validar" />
      </div>
      <ul class="vho-pelis" data-el="Loop Grid (CPT «Película») · lista">
        {data.cartelera.items.map((f) => (
          <li>
            <span class="vho-peli-ic"><Icon name="dome" /></span>
            <span class="vho-peli-t"><b>{f.titulo}</b><span>Duración y horarios por validar</span></span>
          </li>
        ))}
      </ul>
    </div>

    <ul class="vho-cond" data-el="Icon List · condiciones">
      {data.condiciones.map((c) => <li><Icon name="help" size="20" />{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .vho-hor { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .vho-hor li { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 28px; border-radius: var(--mk-r-28); background: var(--mk-fondo-tonal); }
  .vho-ib { background: #fff; }
  .vho-hora { font-size: var(--mk-h3); font-weight: 700; line-height: 1.2; color: var(--mk-violeta-700); }

  .vho-prod { margin-top: 80px; scroll-margin-top: 160px; }
  .vho-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .vp { display: flex; flex-direction: column; border: 1px solid var(--mk-borde); border-radius: var(--mk-r-28); overflow: hidden; background: #fff; }
  .vp--destacado { border: 2px solid var(--mk-violeta-700); }
  .vp-media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--mk-neutro-100); }
  .vp-media :global(picture), .vp-media :global(.vp-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vp-media :global(.vp-chip) { position: absolute; left: 12px; top: 12px; }
  .vp-body { flex: 1; display: flex; flex-direction: column; gap: 12px; padding: 20px 20px 24px; }
  .vp-desc { font-size: var(--mk-small); color: var(--mk-texto-2); }
  .vp-incluye { display: grid; gap: 6px; font-size: var(--mk-small); font-weight: 600; }
  .vp-incluye li { display: flex; gap: 8px; align-items: flex-start; }
  .vp-incluye :global(.mk-ic) { color: var(--mk-exito); margin-top: 1px; }
  .vp-precios { display: grid; gap: 0; margin-top: auto; border-top: 1px solid var(--mk-borde); }
  .vp-precios div { display: flex; justify-content: space-between; gap: 8px; padding-block: 8px; border-bottom: 1px solid var(--mk-borde); font-size: var(--mk-small); }
  .vp-precios dt { color: var(--mk-texto-2); }
  .vp-precios dd { margin: 0; font-weight: 700; color: var(--mk-texto-2); }

  .vho-compra { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; margin-top: 24px; padding: 24px 28px; border-radius: var(--mk-r-28); background: var(--mk-fondo-tonal); }
  .vho-compra p { flex: 1 1 320px; color: var(--mk-texto-2); }
  .vho-compra b { color: var(--mk-texto); }
  .vho-domo { display: grid; grid-template-columns: 5fr 7fr; gap: 40px 64px; align-items: center; margin-top: 56px; padding: 48px; border-radius: var(--mk-r-28); background: var(--mk-oscuro); color: #fff; }
  .vho-domo-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .vho-domo-txt p { color: var(--mk-oscuro-texto); }
  .vho-pelis { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .vho-pelis li { display: flex; gap: 14px; align-items: center; padding: 18px; border-radius: var(--mk-r-20); background: var(--mk-oscuro-superficie); border: 1px solid var(--mk-oscuro-linea); }
  .vho-peli-ic { width: 44px; height: 44px; flex: none; border-radius: 14px; display: grid; place-items: center; background: var(--mk-oscuro-linea); color: var(--mk-cyan-500); }
  .vho-peli-t { display: grid; gap: 2px; }
  .vho-peli-t b { font-weight: 600; color: #fff; }
  .vho-peli-t span { font-size: 13px; color: var(--mk-oscuro-texto-3); }

  .vho-cond { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 32px; font-size: var(--mk-small); color: var(--mk-texto-2); }
  .vho-cond li { display: flex; gap: 8px; align-items: center; }
  .vho-cond :global(.mk-ic) { color: var(--mk-violeta-700); }

  @media (max-width: 1024px) {
    .vho-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vho-domo { grid-template-columns: 1fr; padding: 40px; }
    .vho-prod { margin-top: 64px; }
  }
  @media (max-width: 767px) {
    .vho-hor { grid-template-columns: 1fr; }
    .vho-hor li { padding: 20px; flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: 14px; }
    .vho-hor li .t-h5 { flex: 1; }
    .vho-hora { flex-basis: 100%; }
    .vho-grid { grid-template-columns: 1fr; }
    .vho-domo { padding: 28px 20px; border-radius: var(--mk-r-20); }
    .vho-pelis { grid-template-columns: 1fr; }
    .vho-prod { margin-top: 56px; }
  }
</style>
