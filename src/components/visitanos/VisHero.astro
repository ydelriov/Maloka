---
/* Encabezado de Visítanos: lleva a tarifas y a cómo llegar (la compra vive en el header y al final de las tarifas)
   y muestra la tarjeta «Hoy en Maloka» con los dos horarios. */
import data from '../../data/visitanos.json';
import site from '../../data/site.json';
import PageHero from '../pagina/PageHero.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import EstadoHoy from '../ui/EstadoHoy.astro';
---
<PageHero titulo={data.hero.titulo} lead={data.hero.lead}>
  <Fragment slot="ctas">
    <Button href="#tarifas" variant="destacado" size="lg" icon="arrow" class="btn--movil-bloque">Ver tarifas</Button>
    <Button href="#llegar" variant="invertido" size="lg" class="btn--movil-bloque">Cómo llegar</Button>
  </Fragment>
  <aside slot="aside" class="vh-hoy" aria-labelledby="vh-hoy-t" data-el="Contenedor · Fondo violeta 800 · Radio 28 · Icon List">
    <p class="vh-hoy-eb" id="vh-hoy-t">Hoy en Maloka</p>
    <EstadoHoy />
    <ul class="vh-hor">
      <li><Icon name="clock" size="20" /><span><b>{site.horarios.semana.dias}</b>{site.horarios.semana.texto}</span></li>
      <li><Icon name="cal" size="20" /><span><b>{site.horarios.finde.dias}</b>{site.horarios.finde.texto}</span></li>
      <li><Icon name="ticket" size="20" /><span>{site.horarios.ventaHasta}</span></li>
      <li><Icon name="pin" size="20" /><span>{site.direccion}</span></li>
    </ul>
  </aside>
</PageHero>

<style>
  .vh-hoy { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 32px; border-radius: var(--mk-r-28); background: var(--mk-violeta-800); border: 1px solid var(--mk-violeta-600); }
  .vh-hoy-eb { font-size: 14px; font-weight: 600; color: var(--mk-violeta-200); }
  .vh-hor { display: grid; gap: 14px; width: 100%; }
  .vh-hor li { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; color: var(--mk-violeta-100); }
  .vh-hor li + li { padding-top: 14px; border-top: 1px solid var(--mk-violeta-600); }
  .vh-hor b { display: block; font-weight: 600; color: #fff; }
  .vh-hor :global(.mk-ic) { color: var(--mk-violeta-300); margin-top: 1px; }
  @media (max-width: 767px) { .vh-hoy { padding: 24px 20px; border-radius: var(--mk-r-20); } }
</style>
