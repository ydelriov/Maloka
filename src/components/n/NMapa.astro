---
/* Mapa de Colombia por departamentos con los territorios a los que ha llegado Maloka (V13, en lugar de las cifras).
   Los departamentos alcanzados van en noche; el resto, en blanco translúcido. Bogotá lleva el punto de la sede.
   Versión compacta: mapa pequeño con la cifra; el nombre y el programa salen al pasar el mouse por un departamento.
   Mapa base: @svg-maps/colombia (CC BY 4.0), en src/data/n/colombia.json. */
import mapa from '../../data/n/colombia.json';
const { items = [], sede = 'dc', etiqueta = 'Mapa de Colombia con los territorios de Maloka' } = Astro.props;
const prog = Object.fromEntries(items.map((t) => [t.id, t.programa]));
const deps = mapa.departamentos;
// San Andrés y Providencia van ampliadas arriba a la izquierda, sin recuadro (a escala no se verían);
// Bogotá se dibuja al final para que quede encima de Cundinamarca
const dibujo = [...deps.filter((d) => d.id !== 'sap' && d.id !== 'dc'), ...deps.filter((d) => d.id === 'dc')];
const s = deps.find((d) => d.id === sede);
const sap = deps.find((d) => d.id === 'sap');
// Providencia no viene en el mapa base: contorno simplificado, a la misma escala del recuadro
const providencia = 'm 0,0 3,-2.4 3.4,0.6 1.8,3.2 -0.4,3.8 -2.6,2.8 -3.2,-0.4 -2.2,-3.4 z';
const nombre = (id) => deps.find((d) => d.id === id)?.nombre ?? id;
---
<div class="nma">
  <figure class="nma-fig">
    <svg class="nma-svg" viewBox={mapa.viewBox} role="img" aria-label={`${etiqueta}: ${items.map((t) => nombre(t.id)).join(', ')}.`}>
      {dibujo.map((d) => (
        <path d={d.path} data-dep={d.id} class:list={['nma-dep', prog[d.id] && 'is-ok']}><title>{d.nombre}{prog[d.id] ? ` · ${prog[d.id]}` : ''}</title></path>
      ))}
      {sap && (
        <g class="nma-ins">
          <path d={sap.path} transform="translate(64 120) scale(13)" data-dep="sap" class:list={['nma-dep', prog.sap && 'is-ok']}><title>San Andrés{prog.sap ? ` · ${prog.sap}` : ''}</title></path>
          <path d={providencia} transform="translate(118 72) scale(2.4)" data-dep="sap" class:list={['nma-dep', prog.sap && 'is-ok']}><title>Providencia{prog.sap ? ` · ${prog.sap}` : ''}</title></path>
          <text x="32" y="198">San Andrés y</text>
          <text x="32" y="214">Providencia</text>
        </g>
      )}
      {s && (
        <g class="nma-sede" transform={`translate(${s.cx} ${s.cy})`} aria-hidden="true">
          <circle r="16" class="nma-pulso" />
          <circle r="7" />
          <text x="22" y="5">Maloka</text>
        </g>
      )}
    </svg>
    <figcaption class="nma-cap"><span><i class="nma-ley nma-ley--ok"></i>Territorios con presencia de Maloka</span><span><i class="nma-ley"></i>Por llegar</span></figcaption>
  </figure>
  <p class="nma-total"><b class="t-num">{items.length}</b><span>departamentos donde ha estado Maloka</span></p>
</div>

<style>
  .nma { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 24px; align-items: end; }
  .nma-fig { margin: 0; display: grid; gap: 12px; grid-row: span 2; }
  .nma-svg { width: 100%; height: auto; max-width: 280px; overflow: visible; }
  .nma-dep { fill: rgba(255, 255, 255, .55); stroke: var(--n-noche); stroke-width: .8; stroke-linejoin: round; transition: fill var(--mk-t-rapida); }
  .nma-dep.is-ok { fill: var(--n-noche); stroke: var(--n-menta); }
  .nma-dep.is-ok:hover { fill: var(--n-amarillo); stroke: var(--n-noche); stroke-width: 1.4; }
  .nma-ins .nma-dep { vector-effect: non-scaling-stroke; }
  .nma-ins text { font: 600 15px Montserrat, sans-serif; fill: var(--n-noche); }
  .nma-sede { fill: var(--n-amarillo); stroke: var(--n-noche); stroke-width: 2; pointer-events: none; }
  .nma-sede text { font: 700 24px Montserrat, sans-serif; fill: var(--n-noche); stroke: var(--n-menta); stroke-width: 6px; paint-order: stroke; }
  .nma-pulso { fill: none; stroke: var(--n-noche); stroke-width: 2; transform-origin: center; animation: nma-pulso 2.4s var(--mk-ease) infinite; }
  @keyframes nma-pulso { from { transform: scale(.5); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
  .nma-cap { display: grid; gap: 6px; font-size: 13px; font-weight: 600; }
  .nma-cap span { display: inline-flex; align-items: center; gap: 8px; }
  .nma-ley { width: 14px; height: 14px; background: rgba(255, 255, 255, .55); border: 1px solid var(--n-noche); }
  .nma-ley--ok { background: var(--n-noche); }
  .nma-total { display: grid; gap: 6px; max-width: 13ch; padding-bottom: 8px; }
  .nma-total b { font-size: 72px; line-height: .85; font-weight: 700; letter-spacing: -0.03em; }
  .nma-total span { font-weight: 600; }
  @media (max-width: 767px) { .nma-total b { font-size: 56px; } .nma-svg { max-width: 220px; } }
  @media (prefers-reduced-motion: reduce) { .nma-pulso { animation: none; } }
</style>
