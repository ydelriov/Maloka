---
/* Header de V10–V12 con la estructura del de V6 (Theme Builder › Header con el widget Menú en modo mega menú):
   una fila con el logo a la izquierda, las cinco secciones y el único botón («Compra tus entradas», amarillo).
   Escritorio (> 1200 px): cada sección abre un panel a ancho completo al pasar el mouse o con Enter/Espacio;
   Esc lo cierra y devuelve el foco. ≤ 1200 px: desplegable debajo del header con submenús en acordeón.
   Estilo DS v3: esquinas rectas, iconos en cuadros pastel, horario de hoy en un recuadro noche.
   variante: «noche» · «hueso» · «blanco». También activa la aparición al hacer scroll ([data-rv]) de la página. */
import nav from '../../data/nav.json';
import site from '../../data/site.json';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { ruta } from '../../lib/rutas.js';
const { variante = 'noche', inicio = '#' } = Astro.props;
const COLOR = { visitanos: 'amarillo', agendate: 'cielo', grupo: 'salmon', descubre: 'menta', crea: 'lavanda' };
---
<header class:list={['nh', `nh--${variante}`]} data-nh>
  <div class="mk-w nh-bar">
    <a class="nh-logo" href={inicio} aria-label="Maloka, ir al inicio"><Logo size={44} /></a>

    <nav class="nh-nav" aria-label="Principal">
      <ul class="nh-list">
        {nav.items.map((it) => it.links.length > 1 ? (
          <li data-mm-item>
            <button class="nh-trig" type="button" aria-expanded="false" aria-controls={`nmm-${it.id}`}>
              {it.label}<Icon name="down" size="18" class="nh-chev" />
            </button>
            <div class="nmm" id={`nmm-${it.id}`} style={`--c:var(--n-${COLOR[it.id] || 'lavanda'})`} data-mm hidden>
              <div class="mk-w nmm-in">
                <div class="nmm-intro">
                  <p class="nmm-ante">{it.label}</p>
                  <p class="nmm-intro-t">{it.intro}</p>
                  <a class="n-a" href={ruta(it.label)}>Ver todo<Icon name="arrow" size="20" /></a>
                </div>
                <ul class="nmm-links">
                  {it.links.map((l) => (
                    <li><a class="nmm-link" href={ruta(l.label)}><span class="nmm-ib"><Icon name={l.icono} /></span><span><b>{l.label}</b>{l.desc && <small>{l.desc}</small>}</span></a></li>
                  ))}
                </ul>
                {it.horarioHoy ? (
                  <aside class="nmm-card" aria-label="Horarios">
                    <p class="nmm-card-t">Horarios</p>
                    <p class="nmm-h"><b>{site.horarios.semana.dias}</b><span>{site.horarios.semana.texto}</span></p>
                    <p class="nmm-h"><b>{site.horarios.finde.dias}</b><span>{site.horarios.finde.texto}</span></p>
                    <p class="nmm-venta">{site.horarios.ventaHasta}</p>
                    <a class="n-a" href={ruta('Cómo llegar')}>Cómo llegar<Icon name="arrow" size="20" /></a>
                  </aside>
                ) : <span aria-hidden="true"></span>}
              </div>
            </div>
          </li>
        ) : (
          <li><a class="nh-trig" href={ruta(it.label)}>{it.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nh-acc">
      <a class="nh-btn" href={site.entradas.url} target="_blank" rel="noopener"><Icon name="ticket" size="20" />{site.entradas.texto}<span class="sr-only"> (abre en una pestaña nueva)</span></a>
      <button class="nh-burger" type="button" aria-label="Menú" aria-expanded="false" aria-controls="nh-desplegable" data-nh-burger><Icon name="menu" size="20" /></button>
    </div>
  </div>

  <div class="nh-dd" id="nh-desplegable" hidden data-nh-dd>
    <div class="mk-w">
      <ul class="nh-dd-list">
        {nav.items.map((it) => (
          <li>
            {it.links.length > 1 ? (
              <>
                <button class="nh-dd-trig" type="button" aria-expanded="false" aria-controls={`ndd-${it.id}`}>
                  {it.label}<Icon name="down" size="20" class="nh-chev" />
                </button>
                <ul class="nh-dd-sub" id={`ndd-${it.id}`} style={`--c:var(--n-${COLOR[it.id] || 'lavanda'})`} hidden>
                  {it.links.map((l) => <li><a href={ruta(l.label)}><span class="nmm-ib nmm-ib--s"><Icon name={l.icono} size="18" /></span>{l.label}</a></li>)}
                </ul>
              </>
            ) : (
              <a class="nh-dd-trig" href={ruta(it.label)}>{it.label}</a>
            )}
          </li>
        ))}
      </ul>
      <div class="nh-dd-datos">
        <p><Icon name="clock" size="20" /><span>L–V {site.horarios.semana.texto} · Fines de semana y festivos {site.horarios.finde.texto}</span></p>
        <p><Icon name="pin" size="20" /><span>{site.direccion}</span></p>
        <p><Icon name="phone" size="20" /><a href={`tel:${site.telefonoHref}`}>{site.telefono}</a></p>
      </div>
    </div>
  </div>
</header>

<style>
  .nh { --nh-bg: #fff; --nh-tx: var(--n-noche); --nh-sub: var(--n-texto2); --nh-ln: rgba(35, 27, 43, .16); position: sticky; top: 0; z-index: 100; background: var(--nh-bg); color: var(--nh-tx); border-bottom: 1px solid var(--nh-ln); transition: box-shadow var(--mk-t) var(--mk-ease); }
  .nh--hueso { --nh-bg: var(--mk-hueso); }
  .nh--noche { --nh-bg: var(--n-noche); --nh-tx: #fff; --nh-sub: var(--n-texto2-osc); --nh-ln: var(--n-linea); }
  .nh.is-fijo { box-shadow: 0 8px 24px rgba(35, 27, 43, .12); }
  .nh :focus-visible { outline: 3px solid var(--n-lavanda-osc); outline-offset: 2px; }
  .nh--noche :focus-visible { outline-color: var(--n-lavanda); }
  .nh-bar { height: 80px; display: flex; align-items: center; gap: 32px; }
  .nh-logo { display: inline-flex; color: inherit; flex: none; }
  .nh-nav { flex: 1; }
  .nh-list { display: flex; align-items: center; gap: 4px; }
  .nh-trig { position: relative; display: inline-flex; align-items: center; gap: 4px; min-height: 44px; padding: 8px 12px; border: 0; background: none; color: inherit; font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; white-space: nowrap; }
  .nh-trig::after { content: ""; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 2px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform var(--mk-t-rapida) var(--mk-ease); }
  .nh-trig:hover::after, .nh-trig[aria-expanded="true"]::after { transform: scaleX(1); }
  .nh--noche .nh-trig:hover, .nh--noche .nh-trig[aria-expanded="true"] { color: var(--n-amarillo); }
  :global(.nh-chev) { transition: transform var(--mk-t-rapida) var(--mk-ease); }
  [aria-expanded="true"] > :global(.nh-chev) { transform: rotate(180deg); }
  .nh-acc { display: flex; align-items: center; gap: 8px; flex: none; margin-left: auto; }
  .nh-btn { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 20px; border-radius: 999px; background: var(--n-amarillo); color: var(--n-noche); font-size: 15px; font-weight: 700; white-space: nowrap; box-shadow: inset 0 0 0 2px var(--n-noche); transition: background-color var(--mk-t-rapida), color var(--mk-t-rapida); }
  .nh-btn:hover { background: var(--n-noche); color: var(--n-amarillo); }
  .nh--noche .nh-btn { box-shadow: none; }
  .nh--noche .nh-btn:hover { background: #fff; color: var(--n-noche); }
  .nh-burger { display: none; place-items: center; width: 44px; height: 44px; padding: 0; border: 2px solid currentColor; background: none; color: inherit; cursor: pointer; }

  /* Mega menú: panel a ancho completo */
  .nmm { position: absolute; left: 0; right: 0; top: 100%; background: var(--nh-bg); color: var(--nh-tx); border-top: 1px solid var(--nh-ln); box-shadow: 0 16px 32px rgba(35, 27, 43, .14); }
  .nmm-in { display: grid; grid-template-columns: 240px 1fr 300px; gap: 40px; padding-block: 40px; align-items: start; }
  .nmm-intro { display: grid; gap: 10px; justify-items: start; }
  .nmm-ante { font-size: 14px; font-weight: 700; color: var(--n-lavanda-osc); }
  .nh--noche .nmm-ante { color: var(--n-lavanda); }
  .nmm-intro-t { font-size: 20px; font-weight: 600; line-height: 1.35; }
  .nmm-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 24px; }
  .nmm-link { display: flex; align-items: center; gap: 14px; min-height: 64px; padding: 8px 12px 8px 8px; color: inherit; transition: background-color var(--mk-t-rapida), color var(--mk-t-rapida); }
  .nmm-link:hover { background: var(--c); color: var(--n-noche); }
  .nmm-link b { display: block; font-size: 16px; font-weight: 700; }
  .nmm-link small { display: block; font-size: 14px; color: var(--nh-sub); line-height: 1.4; }
  .nmm-link:hover small { color: var(--n-noche); }
  .nmm-ib { display: grid; place-items: center; flex: none; width: 44px; height: 44px; background: var(--c); color: var(--n-noche); }
  .nmm-link:hover .nmm-ib { background: var(--n-noche); color: var(--c); }
  .nmm-ib--s { width: 32px; height: 32px; }
  .nmm-card { display: grid; gap: 10px; justify-items: start; padding: 24px; background: var(--n-noche); color: #fff; }
  .nh--noche .nmm-card { background: var(--n-carbon); }
  .nmm-card-t { font-size: 14px; font-weight: 700; color: var(--n-lavanda); }
  .nmm-h { display: grid; font-size: 14px; }
  .nmm-h b { font-weight: 700; }
  .nmm-h span { color: var(--n-texto2-osc); }
  .nmm-venta { font-size: 13px; color: var(--n-texto2-osc); }
  .nmm-card .n-a { color: var(--n-amarillo); }

  /* Desplegable ≤ 1200 px */
  .nh-dd { position: absolute; left: 0; right: 0; top: 100%; max-height: calc(100dvh - 72px); overflow-y: auto; background: var(--nh-bg); color: var(--nh-tx); border-top: 1px solid var(--nh-ln); box-shadow: 0 16px 32px rgba(35, 27, 43, .14); padding-bottom: 24px; }
  .nh-dd-list > li { border-bottom: 1px solid var(--nh-ln); }
  .nh-dd-trig { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 60px; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-size: 18px; font-weight: 700; text-align: left; cursor: pointer; }
  .nh-dd-sub { display: grid; padding: 0 0 12px; }
  .nh-dd-sub a { display: flex; align-items: center; gap: 12px; min-height: 48px; font-weight: 600; color: inherit; }
  .nh-dd-datos { display: grid; gap: 10px; padding-top: 20px; font-size: 14px; color: var(--nh-sub); }
  .nh-dd-datos p { display: flex; gap: 10px; align-items: flex-start; }
  .nh-dd-datos a { color: inherit; }

  @media (max-width: 1200px) {
    .nh-nav { display: none; }
    .nh-bar { height: 72px; }
    .nh-burger { display: inline-grid; }
  }
  @media (max-width: 479px) {
    .nh-btn { padding: 0 14px; font-size: 14px; }
    .nh-btn :global(.mk-ic) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .nh-trig::after, :global(.nh-chev) { transition: none; } }
</style>

<script>
  /* Aparición al hacer scroll de toda la página */
  document.documentElement.classList.add('n-js');
  const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' }) : null;
  document.querySelectorAll('[data-rv]').forEach((el) => (io ? io.observe(el) : el.classList.add('is-in')));

  const header = document.querySelector('[data-nh]');
  const escritorio = window.matchMedia('(min-width: 1201px)');
  const mouse = window.matchMedia('(hover: hover) and (pointer: fine)');
  const onScroll = () => header.classList.toggle('is-fijo', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const burger = header.querySelector('[data-nh-burger]');
  const dd = header.querySelector('[data-nh-dd]');

  /* Mega menú (escritorio) */
  let abierto = null, t;
  const boton = (li) => li.querySelector('button');
  const panel = (li) => li.querySelector('[data-mm]');
  function abrir(li) {
    if (abierto === li) return;
    if (abierto) cerrar(false);
    abierto = li;
    boton(li).setAttribute('aria-expanded', 'true');
    panel(li).hidden = false;
  }
  function cerrar(foco) {
    if (!abierto) return;
    const b = boton(abierto);
    b.setAttribute('aria-expanded', 'false');
    panel(abierto).hidden = true;
    abierto = null;
    if (foco) b.focus();
  }
  header.querySelectorAll('[data-mm-item]').forEach((li) => {
    boton(li).addEventListener('click', () => (abierto === li ? cerrar(false) : abrir(li)));
    li.addEventListener('mouseenter', () => { if (mouse.matches && escritorio.matches) { clearTimeout(t); abrir(li); } });
    li.addEventListener('mouseleave', () => { if (mouse.matches) { clearTimeout(t); t = setTimeout(() => cerrar(false), 200); } });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget) && abierto === li) cerrar(false); });
  });

  /* Desplegable (≤ 1200 px) */
  const setDd = (open, foco) => {
    dd.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Menú');
    if (!open && foco) burger.focus();
  };
  burger.addEventListener('click', () => setDd(dd.hidden));
  dd.querySelectorAll('button[aria-controls]').forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    document.getElementById(b.getAttribute('aria-controls')).hidden = open;
  }));
  escritorio.addEventListener('change', (e) => { if (e.matches) setDd(false); });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (abierto) cerrar(true);
    else if (!dd.hidden) setDd(false, true);
  });
  document.addEventListener('click', (e) => {
    if (abierto && !abierto.contains(e.target)) cerrar(false);
    if (!dd.hidden && !header.contains(e.target)) setDd(false);
  });
</script>
